# Salin ke .env bila ingin mengganti nilai bawaan development. Jangan commit .env.
DB_PASSWORD=vynance_dev
DB_ROOT_PASSWORD=root_dev

# Auth (tiket #6). Tanpa Google: tombol Google disembunyikan. Tanpa EMAIL_API_KEY: kode OTP dicetak di log api.
AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
EMAIL_API_KEY=
# Pengirim. Tanpa domain terverifikasi di Resend pakai: Vynance <onboarding@resend.dev>
EMAIL_FROM=

# Harga emas per gram (JSON { "price": n }). Kosong = cache/bawaan.
GOLD_PRICE_URL=

# AI advisor lewat OpenRouter (ADR 0006). Kosong = fitur AI mati.
LLM_API_KEY=
LLM_MODEL=anthropic/claude-opus-5.5

# Langfuse: observabilitas LLM (latensi, token, biaya). Kosong = tidak dicatat.
# Cloud: https://cloud.langfuse.com (EU) atau https://us.cloud.langfuse.com. Bisa juga self-host.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# 1 = prompt & jawaban ikut direkam (berisi data keuangan pengguna). Bawaan 0: hanya metrik.
LANGFUSE_CAPTURE_CONTENT=0
